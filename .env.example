# ── Data source ───────────────────────────────────────────────────────────────
# Which provider feeds the dashboard:
#   cboe    — FREE. CBOE's public delayed-quotes CDN: full option chains with
#             per-contract volume, 15 minutes delayed. No key, no account.
#             (Default when no API key is set.)
#   massive — Massive.com (formerly Polygon.io). Real-time on paid options
#             plans; the free tier is 5 calls/min end-of-day only.
#   demo    — built-in simulator (synthetic flow, works offline).
DATA_PROVIDER=cboe

# ── Massive.com (only needed for DATA_PROVIDER=massive) ───────────────────────
MASSIVE_API_KEY=
# Calls per minute your plan allows (free tier = 5).
MASSIVE_RPM=5

# ── CBOE feed pacing ──────────────────────────────────────────────────────────
# Requests per minute against the CBOE CDN, shared by everything that calls it.
# The poller spends it on a tiered schedule (src/lib/refresh-schedule.ts): with
# the ~1,400-name universe at 90/min, the busiest ~100 names refresh about every
# 3 minutes, the next 300 about every 11, the quiet rest about every 32.
# POLL_INTERVAL_SEC does not affect freshness. This is a CEILING: on a 429 the
# limiter eases by a quarter and climbs back 5% per quiet minute, because the
# CDN's tolerance varies (worst near the close). Chains arrive compressed (SPY:
# 5.9 MB raw, ~0.8 MB on the wire), and inbound traffic is not what a host like
# Railway meters.
CBOE_RPM=90

# ── Database (optional — dashboard degrades gracefully without it) ────────────
# PostgreSQL connection string, e.g. from Neon or Railway:
# DATABASE_URL="postgresql://user:pass@host:5432/optionsflow"
DATABASE_URL=

# ── SEC EDGAR (earnings confirmation, optional) ───────────────────────────────
# Required to confirm earnings history from 8-K Item 2.02 filings. SEC blocks
# requests without a declared contact, so set this to a real email you monitor;
# it goes into the User-Agent. Leave blank to disable EDGAR confirmation.
SEC_CONTACT_EMAIL=

# ── Server ────────────────────────────────────────────────────────────────────
# Do NOT set PORT on Railway/Render — the platform injects it.
PORT=3000

# Poll cadence in seconds (min 15). On rate-limited sources the poller cycles
# tickers within the per-minute budget regardless of this value.
POLL_INTERVAL_SEC=30

# Optional cap on tracked tickers. Unset = the whole universe: the curated core
# (~540, src/lib/universe.ts) plus the generated extension ordered by measured
# options activity (src/lib/universe-extended.ts) — ~1,400 in all. A cap keeps
# the core and trims the extension's least active names first.
# MAX_TICKERS=1400

# By default the poller idles outside regular trading hours (and on weekends /
# market holidays), where the delayed feed is static — this cuts roughly 80% of
# a 24/7 loop's requests and host usage. Set to 1 to poll round the clock.
POLL_WHEN_CLOSED=0

# ── Live underlying quotes ────────────────────────────────────────────────────
# The option chain is 15-min delayed (OPRA licensing) and costs 0.4–6 MB per
# symbol, so prices there only refresh as fast as the rotation (~9 min at 552
# tickers). This sweep fetches live last-trade prices for the WHOLE universe
# in 20-symbol batches — ~28 requests and ~580 KB per pass, about 1.4% of one
# chain rotation — so price freshness is independent of the chain.
# Measured: 541/552 symbols in ~6s, median quote age ~11s.
#   yahoo = Yahoo spark endpoint (undocumented; degrades to "no quote", never
#           to a wrong number). off = disable the sweep entirely.
QUOTE_SOURCE=yahoo
# Every QUOTE_INTERVAL_SEC the sweep covers the hot set (benchmarks, watchlist,
# QUOTE_HOT_SYMBOLS most active names); the whole universe every
# QUOTE_FULL_SWEEP_SEC. That keeps the request rate near the old 552-name sweep
# (~28/min) at ~1,400 names.
QUOTE_INTERVAL_SEC=60
QUOTE_HOT_SYMBOLS=300
QUOTE_FULL_SWEEP_SEC=300
# Delay between batches, keeping a full sweep well under 1 request/second.
QUOTE_PAUSE_MS=120
